# =============================================================
#  SUPPORTFLOW — FRONTEND ENVIRONMENT EXAMPLE
#  Copy this file to `frontend/.env` and fill in real values.
#  frontend/.env is git-ignored.
#  Values come from Firebase console -> Project settings -> Your apps
#  -> SDK setup and configuration (for web).
# =============================================================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Base URL of the backend Cloud Functions REST API.
# Local functions emulator:
VITE_API_URL=http://localhost:5001/<PROJECT_ID>/us-central1/api
# Production (after `firebase deploy --only functions`):
# VITE_API_URL=https://<region>-<project>.cloudfunctions.net/api

# When "true", the web SDK connects to LOCAL Firebase emulators
# (auth :9099, firestore :8080) — requires the full emulator suite.
VITE_USE_EMULATORS=false