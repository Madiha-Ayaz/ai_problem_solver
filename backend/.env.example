# =============================================================
#  SUPPORTFLOW — BACKEND ENVIRONMENT EXAMPLE
#  Copy this file to `backend/.env` and fill in real values.
#  backend/.env is git-ignored — NEVER commit real secrets.
#  In production use Firebase Secret Manager instead:
#      firebase functions:secrets:set AI_API_KEY
# =============================================================

# Firebase Web API key. Needed by /api/auth/login (identitytoolkit) and by
# the emulator to talk to the real project.
# FIREBASE_WEB_API_KEY=

# Secret key that unlocks POST /api/admin/bootstrap (first-admin only).
# When empty, bootstrap stays disabled.
ADMIN_BOOTSTRAP_KEY=

# AI provider (OpenAI-compatible REST API). Default in code is Gemini's
# OpenAI-compatible endpoint; override for OpenRouter.
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=minimax/minimax-m3:free
AI_API_KEY=
AI_TIMEOUT_MS=20000

# Optional (NOT used for tickets — Firestore is the source of truth):
# legacy Neon/Postgres connection, scaffolded but unused.
# DATABASE_URL=AI_CHAT_AUTO_RESOLVE=true
